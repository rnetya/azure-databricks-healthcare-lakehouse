# Normalize text files in the repository
* text=auto

# Use LF for cross-platform source/configuration files
*.py       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf
*.toml     text eol=lf
*.xml      text eol=lf

# Windows-native scripts
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binary files
*.png      binary
*.jpg      binary
*.jpeg     binary
*.pdf      binary
*.zip      binary